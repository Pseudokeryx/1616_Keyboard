<?xml version="1.0" encoding="utf-8"?>
<Keyboard xmlns:android="http://schemas.android.com/apk/res/android"
    android:keyWidth="40dp"
    android:horizontalGap="1.5dp"
    android:verticalGap="1.5dp"
    android:keyHeight="50dp"
    android:keyTextColor="@color/Accent"
    android:keyBackground="@color/Secondary">
    <Row>
        <Key android:keyOutputText="(" android:keyLabel="("/>
        <Key android:keyOutputText=")" android:keyLabel=")"/>
        <Key android:keyOutputText="[" android:keyLabel="["/>
        <Key android:keyOutputText="]" android:keyLabel="]"/>
        <Key android:keyOutputText="{" android:keyLabel="{"/>
        <Key android:keyOutputText="}" android:keyLabel="}"/>
    </Row>
    <Row>
        <Key android:keyOutputText="⟨" android:keyLabel="⟨"/>
        <Key android:keyOutputText="⟩" android:keyLabel="⟩"/>
        <Key android:keyOutputText="\u003c" android:keyLabel="\u003c"/>
        <Key android:keyOutputText="\u003e" android:keyLabel="\u003e"/>
        <Key android:keyOutputText="⁅" android:keyLabel="⁅"/>
        <Key android:keyOutputText="⁆" android:keyLabel="⁆"/>
    </Row>
    <Row>
        <Key android:keyOutputText="˥" android:horizontalGap="5%p" android:keyLabel="˥"/>
        <Key android:keyOutputText="˦" android:keyLabel="˦"/>
        <Key android:keyOutputText="˧" android:keyLabel="˧"/>
        <Key android:keyOutputText="˨" android:keyLabel="˨"/>
        <Key android:keyOutputText="˩" android:keyLabel="˩"/>
    </Row>
</Keyboard>